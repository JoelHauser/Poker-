<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Poker.Console</RootNamespace>
    <AssemblyName>Poker.Console</AssemblyName>

    <!--
      The namespace Poker.Console shadows System.Console inside this project, so every
      call to it is written out in full. Worth it: the alternative is naming the tool
      something it is not.
    -->
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Poker.Game\Poker.Game.csproj" />
  </ItemGroup>

</Project>
